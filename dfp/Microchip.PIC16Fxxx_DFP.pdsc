<?xml version="1.0" encoding="UTF-8"?>
<package xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         schemaVersion="1.7.57"
         xsi:noNamespaceSchemaLocation="https://schemas.microchip.com/com/microchip/packs/1.7.57/PACK.MICROCHIP.xsd">
   <vendor>Microchip</vendor>
   <url>https://packs.download.microchip.com/</url>
   <name>PIC16Fxxx_DFP</name>
   <description overview="./OVERVIEW.md">Microchip PIC16Fxxx Series Device Support</description>
   <supportContact>https://www.microchip.com/en-us/support</supportContact>
   <license>LICENSE.txt</license>
   <licenseSets>
      <licenseSet id="all" default="true" gating="false">
         <license name="LICENSE.txt"
                  title="Apache License, Version 2.0"
                  spdx="Apache-2.0"
                  url="https://www.apache.org/licenses/LICENSE-2.0"/>
      </licenseSet>
   </licenseSets>
   <releases>
      <release version="1.9.176" date="2026-09-09">
          - Updated XC8-PIC device-support files for MISRA C:2023 compliance (documented deviations for rules 5.5, 5.8, 20.9, 21.1, and 21.2).
          - Added configuration and ID-location register address macros to C and assembly device headers.
      </release>
      <release version="1.8.167" date="2026-04-22">
        - Added Apache 2.0 license file.
        - Fixed ADCON1 peripheral display in I/O view; added missing peripheral groups for ZCD, DAC1-5, APM, Signal Routing Port, NVM, and WWDT.
      </release>
      <release version="1.7.162" date="2025-03-26">
        - Restored caspic.h with deprecated warnings.
        - Removed legacy header files and provided deprecated warnings.
        - Removed asxxxx.h files.
      </release>
      <release version="1.6.156" date="2023-10-12">Added low voltage programming flag.</release>
      <release version="1.5.151" date="2023-08-17">Removed header files that now exist in XC8.</release>
      <release version="1.4.149" date="2023-03-22">Decouple library headers from pack.</release>
      <release version="1.3.42" date="2021-11-17">Updated REAL ICE trace macros.</release>
      <release version="1.2.33" date="2020-02-12">Fixed configuration words to be 14 bits wide. Added XC8 support files.</release>
      <release version="1.1.23" date="2019-10-29">Maintenance release.</release>
      <release version="1.0.9" date="2019-01-24">Initial release.</release>
   </releases>
   <keywords>
      <keyword>Microchip</keyword>
      <keyword>Device Family Package Microchip</keyword>
      <keyword>Device Support</keyword>
      <keyword>PIC16Fxxx</keyword>
      <keyword>Microcontrollers and Processors</keyword>
      <keyword>8-bit Microcontrollers</keyword>
      <keyword>Automotive Recommended</keyword>
      <keyword>8</keyword>
      <keyword>Bit Microcontrollers</keyword>
      <keyword>Bit</keyword>
      <keyword>Microcontrollers</keyword>
      <keyword>Microcontrollers And Processors</keyword>
      <keyword>And</keyword>
      <keyword>Processors</keyword>
      <keyword>8-Bit Microcontrollers</keyword>
   </keywords>
   <devices>
      <family Dfamily="PIC16Fxxx" Dvendor="Microchip:3">
         <environment name="microchip">
            <mchp:extension xmlns:mchp="http://crownking/pack-device-microchip-extension"
                            schemaVersion="1.0"
                            xsi:schemaLocation="http://crownking/pack-device-microchip-extension PACK.DEVICE.MICROCHIP.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/mchp/1.0/PACK.DEVICE.MICROCHIP.EXTENSION.xsd-->
               <mchp:prerequisite component="MPLAB X IDE" version="[5.10-"/>
               <mchp:prerequisite component="MPLAB X IPE" version="[5.10-"/>
            </mchp:extension>
         </environment>
         <device Dname="PIC16F505">
            <processor Dcore="16c5x"
                       Dendian="Little-endian"
                       Dmpu="NO_MPU"
                       Dfpu="NO_FPU"
                       Ddsp="NO_DSP"
                       Dtz="NO_TZ"/>
            <environment name="microchip">
               <mchp:extension xmlns:mchp="http://crownking/pack-device-microchip-extension"
                               schemaVersion="1.0"
                               xsi:schemaLocation="http://crownking/pack-device-microchip-extension PACK.DEVICE.MICROCHIP.EXTENSION.xsd"><!--https://schemas.microchip.com/com/microchip/packs/extensions/mchp/1.0/PACK.DEVICE.MICROCHIP.EXTENSION.xsd-->
                  <mchp:pic name="edc/PIC16F505.PIC"/>
                  <mchp:ac-as-pic name="edc/AC162059_AS_PIC16F505.PIC" ac="AC162059"/>
                  <mchp:xc8 name="xc8"/>
                  <mchp:hwtool type="mplab.mpheader">
                     <mchp:file name="hwtools/mplab/MPHeader.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="mplab.pluginboardsupport">
                     <mchp:file name="hwtools/mplab/PluginBoardSupport.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="sdm">
                     <mchp:file name="hwtools/sdm/sdmCompilers.xml"/>
                     <mchp:file name="hwtools/sdm/sdmDebuggerMap.xml"/>
                     <mchp:file name="hwtools/sdm/sdmICD3.xml"/>
                     <mchp:file name="hwtools/sdm/sdmICD4.xml"/>
                     <mchp:file name="hwtools/sdm/sdmICD5.xml"/>
                     <mchp:file name="hwtools/sdm/sdmICE4.xml"/>
                     <mchp:file name="hwtools/sdm/sdmRealICE.xml"/>
                     <mchp:file name="hwtools/sdm/sdmRealICE4.xml"/>
                     <mchp:file name="hwtools/sdm/sdmSimulator.xml"/>
                  </mchp:hwtool>
                  <mchp:hwtool type="persfr">
                     <mchp:file name="hwtools/persfr/pic16.persfr"/>
                  </mchp:hwtool>
                  <mchp:prerequisite component="MPLAB X IDE" version="[5.35-"/>
                  <mchp:prerequisite component="MPLAB XC8" version="[2.20-"/>
               </mchp:extension>
            </environment>
            <book name="https://www.microchip.com/en-us/product/PIC16F505"
                  title="Device page for PIC16F505"/>
            <book name="https://ww1.microchip.com/downloads/aemDocuments/documents/OTH/ProductDocuments/DataSheets/41236E.pdf"
                  title="PIC12F508/509/16F505 8/14-Pin, 8-Bit Flash Microcontrollers"/>
